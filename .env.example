# Google Apps Script web app URL that writes form submissions to the Google Sheet.
# Copy this file to .env.local and paste the "Web app URL" from Deploy > New deployment.
VITE_GOOGLE_SHEET_URL=

# StrategicERP is called from the server function in /api, not from the browser.
# This cloud form does not use a key. If StrategicERP later issues one, store it
# as a server environment variable and never prefix it with VITE_.
